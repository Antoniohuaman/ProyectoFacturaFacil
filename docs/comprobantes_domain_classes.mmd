  +int Version
  +EstadoComprobante Estado
  +TipoDeComprobante Tipo
  +SerieYNumero? SerieNumero
  +FechaEmision Emision
  +FechaVencimiento Vencimiento
  +FormaDePago FormaDePago
  +Moneda Moneda
  +TipoCambio? TipoCambio
  +ClienteSnapshot Cliente
  +EmisorSnapshot Emisor
  +DescuentoGlobal DescuentoGlobal
  +IReadOnlyList~ComprobanteLinea~ Lineas
  +AgregarLinea(DescripcionProducto, UnidadDeMedida, Cantidad, ImporteMonetario, AfectacionImpuesto, TasaImpuesto, bool precioIncluyeIgv, DescuentoLinea?)
  +AgregarLinea(ComprobanteLinea)
  +EditarLinea(int numeroLinea, ...)
  +ActualizarLinea(int numeroLinea, Action~ComprobanteLinea~)
  +EliminarLinea(int numeroLinea)
  +AsignarSerieYNumero(SerieYNumero)
  +CambiarCliente(ClienteSnapshot)
  +CambiarFormaDePago(FormaDePago, int? diasCredito)
  +CambiarVencimiento(FechaVencimiento)
  +CambiarMoneda(Moneda, TipoCambio, bool convertirPrecios)
  +CambiarDescuentoGlobal(DescuentoGlobal)
  +RecalcularTotales()
  +Emitir()
  +MarcarCorregir(string detalle)
  +MarcarAceptado()
  +MarcarRechazado(string codigo, string descripcion)
  +MarcarAnulado(DateTimeOffset cdrBajaEnUtc)
  +DrainDomainEvents(): IReadOnlyCollection~IDomainEvent~
}

%% Entities
class ComprobanteLinea {
  +int NumeroLinea
  +DescripcionProducto Descripcion
  +UnidadDeMedida UM
  +Cantidad Cantidad
  +ImporteMonetario PrecioUnitario
  +bool PrecioIncluyeIgv
  +AfectacionImpuesto AfectacionImpuesto
  +TasaImpuesto TasaImpuesto
  +DescuentoLinea Descuento
  +CentroDeCosto? CentroDeCosto
  +ImporteMonetario UnitPriceSinIgv
  +ImporteMonetario UnitPriceConIgv
  +ImporteMonetario BaseImponible
  +ImporteMonetario Igv
  +ImporteMonetario ImporteTotal
  +CambiarDescripcion(DescripcionProducto)
  +CambiarUnidad(UnidadDeMedida)
  +CambiarCantidad(Cantidad)
  +CambiarPrecio(ImporteMonetario, bool? incluyeIgv)
  +CambiarImpuesto(AfectacionImpuesto, TasaImpuesto)
  +CambiarDescuento(DescuentoLinea)
}

%% Value Objects (representativos)
class ImporteMonetario { +decimal Monto; +Moneda Moneda }
class Moneda { +string Codigo; +int Decimales }
class TipoCambio { +Moneda Origen; +Moneda Destino; +decimal Valor }
class TipoDeComprobante { +string Codigo; +bool RequiereRucCliente }
class SerieYNumero { +string Serie; +int Numero; +string IdUbl }
class FechaEmision { +DateOnly Fecha; +TimeOnly Hora }
class FechaVencimiento { +DateOnly Value }
class ClienteSnapshot { +DocumentoIdentidad Documento; +string Nombre }
class EmisorSnapshot { +EmpresaId EmpresaId; +string Ruc; +string RazonSocial }
class DescuentoLinea { +DescuentoLineaModo Modo; +decimal Valor }
class DescuentoGlobal { +DescuentoGlobalModo Modo; +decimal Valor }
class DescripcionProducto { +string Nombre; +string? Detalle }
class Cantidad { +decimal Value }
class UnidadDeMedida { +string Codigo; +int Decimales }
class AfectacionImpuesto { +string Codigo; +bool GravaImpuesto }
class TasaImpuesto { +decimal Porcentaje; +decimal Fraccion }
class CentroDeCosto
class NotaInterna

%% Services & Repos
class ComprobanteTotalesService { +Calcular(lineas, descuentoGlobal): TotalesDto }
class MonedaConversionService { +Convertir(decimal monto, Moneda desde, Moneda hacia, TipoCambio): decimal }
class IComprobanteRepository { +GetByIdAsync(Guid):ComprobanteElectronico; +AddAsync(ComprobanteElectronico); +UpdateAsync(ComprobanteElectronico, int expectedVersion) }
class IUnitOfWork { +CommitAsync() }
class INumeracionService { +ReservarSiguienteAsync(empresa, establecimiento, tipo, seriePreferida) }
class IComprobanteEmitidoPersister { +GuardarEmitidoAsync(snapshot) }
class IEventBus { +PublishAsync(IDomainEvent) }

%% Domain Events
class ComprobanteEnviadoDomainEvent
class ComprobanteAceptadoDomainEvent
class ComprobanteRechazadoDomainEvent
class ComprobanteAnuladoDomainEvent
class ComprobanteObservadoDomainEvent

%% Relationships
ComprobanteElectronico "1" --> "*" ComprobanteLinea : lineas
ComprobanteElectronico ..> TipoCambio : "tipoCambio (opcional)"
ComprobanteElectronico ..> Moneda : moneda
ComprobanteElectronico ..> ClienteSnapshot : cliente
ComprobanteElectronico ..> EmisorSnapshot : emisor
ComprobanteElectronico ..> ComprobanteTotalesService : usa
ComprobanteElectronico ..> MonedaConversionService : usa
ComprobanteElectronico ..> IComprobanteRepository : "persistencia (repo)"
ComprobanteElectronico ..> IUnitOfWork : "uow"
ComprobanteElectronico ..> IEventBus : "publica eventos drenados"
ComprobanteElectronico ..> INumeracionService : "solicita numeracion (UseCase)"
ComprobanteLinea ..> ImporteMonetario : "precio/base/total"
ComprobanteLinea ..> UnidadDeMedida : "um"
ComprobanteLinea ..> DescuentoLinea : "descuento"
ComprobanteLinea ..> AfectacionImpuesto : "afectacion"
ComprobanteLinea ..> TasaImpuesto : "tasa"

note for ComprobanteElectronico "Reglas clave:\n- Solo BORRADOR/CORREGIR son editables.\n- Al emitir: SerieNumero obligatorio y >=1 línea.\n- Factura (01) requiere RUC; Moneda != PEN requiere TipoCambio.\n- Boleta (03) en PEN con Total>700 exige DNI del cliente.\n- RecalcularTotales valida montos y límites operativos."
